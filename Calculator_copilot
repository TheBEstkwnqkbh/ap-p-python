import ast
import json
import math
import operator
from pathlib import Path
from typing import Any


HISTORY_FILE = Path("calculator_history.json")


def factorial(value: float) -> float:
    if not value.is_integer() or value < 0:
        raise ValueError("factorial requires a non-negative integer")
    return float(math.factorial(int(value)))


FUNCTIONS = {
    "sqrt": math.sqrt,
    "sin": math.sin,
    "cos": math.cos,
    "tan": math.tan,
    "log": math.log,
    "log10": math.log10,
    "abs": abs,
    "ceil": math.ceil,
    "floor": math.floor,
    "factorial": factorial,
}

OPERATORS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.Mod: operator.mod,
    ast.Pow: operator.pow,
}


class SafeCalculator:
    def __init__(self) -> None:
        self.history: list[dict[str, Any]] = []
        self.memory = 0.0
        self.answer = 0.0
        self.load_history()

    def evaluate_node(self, node: ast.AST) -> float:
        if isinstance(node, ast.Expression):
            return self.evaluate_node(node.body)

        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return float(node.value)

        if isinstance(node, ast.Name):
            variables = {
                "pi": math.pi,
                "e": math.e,
                "ans": self.answer,
                "memory": self.memory,
            }

            if node.id in variables:
                return variables[node.id]

            raise ValueError(f"Unknown variable: {node.id}")

        if isinstance(node, ast.BinOp) and type(node.op) in OPERATORS:
            left = self.evaluate_node(node.left)
            right = self.evaluate_node(node.right)

            if isinstance(node.op, ast.Pow) and abs(right) > 100:
                raise ValueError("Exponent is too large")

            return OPERATORS[type(node.op)](left, right)

        if isinstance(node, ast.UnaryOp):
            value = self.evaluate_node(node.operand)

            if isinstance(node.op, ast.USub):
                return -value
            if isinstance(node.op, ast.UAdd):
                return value

        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
            function_name = node.func.id

            if function_name not in FUNCTIONS:
                raise ValueError(f"Unknown function: {function_name}")

            arguments = [self.evaluate_node(arg) for arg in node.args]
            return float(FUNCTIONS[function_name](*arguments))

        raise ValueError("Invalid expression")

    def calculate(self, expression: str) -> float:
        tree = ast.parse(expression, mode="eval")
        result = self.evaluate_node(tree)
        self.answer = result

        self.history.append(
            {
                "expression": expression,
                "result": result,
            }
        )

        self.save_history()
        return result

    def show_help(self) -> None:
        print(
            """
Examples:
  2 + 3 * 4
  sqrt(144)
  sin(pi / 2)
  factorial(5)
  ans * 2
  memory + 10

Available functions:
  sqrt, sin, cos, tan, log, log10
  abs, ceil, floor, factorial

Constants:
  pi, e, ans, memory
"""
        )

    def show_history(self) -> None:
        if not self.history:
            print("No calculation history.")
            return

        print("\nCalculation history:")
        for index, item in enumerate(self.history, start=1):
            print(f"{index}. {item['expression']} = {item['result']:g}")

    def save_history(self) -> None:
        try:
            HISTORY_FILE.write_text(json.dumps(self.history, indent=2))
        except OSError as error:
            print(f"Could not save history: {error}")

    def load_history(self) -> None:
        if not HISTORY_FILE.exists():
            return

        try:
            self.history = json.loads(HISTORY_FILE.read_text())

            if self.history:
                self.answer = float(self.history[-1]["result"])
        except (OSError, json.JSONDecodeError, ValueError):
            self.history = []

    def run(self) -> None:
        print("Advanced Calculator")
        print("Type an expression, 'help', or 'quit'.")

        while True:
            expression = input("\n>>> ").strip()

            if expression.lower() in {"quit", "exit", "q"}:
                print("Goodbye!")
                break

            if expression.lower() in {"help", "?"}:
                self.show_help()
                continue

            if expression.lower() == "history":
                self.show_history()
                continue

            if expression.lower() == "clear":
                self.history.clear()
                self.save_history()
                print("History cleared.")
                continue

            if expression.lower() == "store":
                self.memory = self.answer
                print(f"Stored {self.memory:g} in memory.")
                continue

            if expression.lower() == "recall":
                print(f"Memory: {self.memory:g}")
                continue

            if expression.lower() == "memory clear":
                self.memory = 0.0
                print("Memory cleared.")
                continue

            if not expression:
                continue

            try:
                result = self.calculate(expression)
                print(f"= {result:g}")
            except (ValueError, SyntaxError, ZeroDivisionError, OverflowError) as error:
                print(f"Error: {error}")


if __name__ == "__main__":
    SafeCalculator().run()